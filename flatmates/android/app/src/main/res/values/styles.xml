<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#1C7F72</color>
    <color name="page">#EFE4DC</color>
    <color name="teal">#141414</color>
    <!-- White status bar with dark icons over the white app bar; white navigation bar with dark icons. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
