<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#EE6468</color>
    <color name="page">#FDF8F1</color>
    <color name="teal">#1F1B2E</color>
    <!-- The look of 16 Nov 2026: "brand" is the light red, "page" the cream page (window and navigation bar), and "teal"
         (the name is from an older look) the deep aubergine strip behind the clock, which carries white icons. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
