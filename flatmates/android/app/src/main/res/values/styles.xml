<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#C2410C</color>
    <color name="page">#FFF4E8</color>
    <color name="teal">#1C1917</color>
    <!-- The look of 17 Nov 2026 (the reels'): "brand" is the logo's orange, "page" the cream page (the window, the
         navigation bar and the strip behind the clock, all with dark icons), and "teal" (the name is from an older
         look) the app's near-black. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
