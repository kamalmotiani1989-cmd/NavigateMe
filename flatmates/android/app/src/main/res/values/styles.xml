<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#0E9AA0</color>
    <color name="page">#FFFFFF</color>
    <color name="teal">#0E9AA0</color>
    <!-- Teal status bar with white icons (the top of the app gradient); white navigation bar with dark icons. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/teal</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/teal</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
